datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  VENTAS
  GERENCIA
  MARKETING
  SOPORTE
}

enum OperationType {
  VENTA
  ALQUILER
}

enum PropertyType {
  CASA
  DEPARTAMENTO
  OFICINA
  TERRENO
  LOCAL_COMERCIAL
}

enum PropertyStatus {
  DISPONIBLE
  ALQUILADO
  VENDIDO
  RESERVADO
}

enum ContactStatus {
  PENDIENTE
  LEIDO
  ATENDIDO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(VENTAS)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  location    String
  price       Decimal        @db.Decimal(12, 2)
  operation   OperationType
  type        PropertyType
  area        Float
  beds        Int            @default(0)
  baths       Int            @default(0)
  image       String
  images      String[]
  features    String[]       @default([])
  featured    Boolean        @default(false)
  status      PropertyStatus @default(DISPONIBLE)
  description String?        @db.Text
  address     String?
  districtId  String?
  district    District?      @relation(fields: [districtId], references: [id], onDelete: SetNull)
  stories     SuccessStory[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model District {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  image       String
  description String?
  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Representative {
  id        String   @id @default(cuid())
  name      String
  role      String
  image     String
  email     String?
  phone     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    ContactStatus @default(PENDIENTE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SuccessStory {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  image       String
  clientName  String?
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
